# ---------- Server ----------
PORT=5000
NODE_ENV=development

# ---------- Database ----------
MONGODB_URI=

# ---------- Auth ----------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
COOKIE_SECRET=

# ---------- Client ----------
# One or more origins, comma separated. In production put your Vercel URL here.
CLIENT_URL=http://localhost:5173

# ---------- Platform identity (single teacher) ----------
PLATFORM_NAME=Mr. Shaaban Educational Platform
TEACHER_NAME=Mr. Shaaban
TEACHER_EMAIL=
# Set a real password here BEFORE the first seed. Never commit the one you use.
TEACHER_PASSWORD=
TEACHER_SUBJECT=Arabic

# ---------- Cloudinary (file & video storage) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Engagement rules ----------
INACTIVE_DAYS_THRESHOLD=14
AT_RISK_DAYS_THRESHOLD=5
VIDEO_COMPLETION_THRESHOLD=90

# ---------- Email (password reset) ----------
# Gmail: create an App Password at https://myaccount.google.com/apppasswords
# and paste the 16 characters below without spaces.
# Leave SMTP_USER empty to disable sending; reset links are then printed to the
# server console instead, which is useful while developing.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
PASSWORD_RESET_TTL_MINUTES=60

# ---------- Optional meeting provider ----------
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_ACCOUNT_ID=
